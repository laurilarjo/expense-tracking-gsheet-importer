# Google Sheets API (browser OAuth) — required for login and uploads
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_CLIENT_ID=

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Required for /api/telegram (Vercel + api:dev). Not used by bot:dev long-polling.
TELEGRAM_WEBHOOK_SECRET=

# Google service account JSON (single line) for bot Sheets access
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional FX fallback when workspace has no key
EXCHANGERATES_API_KEY=

# Log level: error | warn | info | debug (default: info).
# Transaction parse/duplicate dumps only appear when set to debug.
LOG_LEVEL=info

# Vercel Blob (production). Omit locally to use .data/blob/
BLOB_READ_WRITE_TOKEN=
